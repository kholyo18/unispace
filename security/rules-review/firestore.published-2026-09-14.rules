rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMod() {
      return request.auth != null
        && request.auth.uid in [
          'QYZAB7X4JyXYgMGGwzgV8U4Mu6f2'
        ];
    }

    match /chats/{chatId} {
      allow get: if request.auth != null && (
        resource == null
        || request.auth.uid in resource.data.memberIds
      );
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid
          || (
            request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['readBy', 'reactions'])
          )
        );
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null
                             && request.auth.uid == userId;
      }
      match /follow_requests/{fromId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == fromId
        );
        allow create: if request.auth != null && request.auth.uid == fromId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == fromId
        );
      }
      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == followedId)
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked_accounts/$(followedId))
          && !exists(/databases/$(database)/documents/users/$(followedId)/blocked_accounts/$(userId));
        allow delete: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == followedId
        );
        allow update: if false;
      }
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && (request.auth.uid == followerId || request.auth.uid == userId)
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked_accounts/$(followerId))
          && !exists(/databases/$(database)/documents/users/$(followerId)/blocked_accounts/$(userId));
        allow delete: if request.auth != null && (
          request.auth.uid == followerId || request.auth.uid == userId
        );
        allow update: if false;
      }
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null
                            && request.auth.uid == userId;
      }
      match /saved_posts/{postId} {
        allow read, write: if request.auth != null
                            && request.auth.uid == userId;
      }
      match /saved_comments/{commentId} {
        allow read, write: if request.auth != null
                            && request.auth.uid == userId;
      }
      match /authored_comments/{commentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /hidden_posts/{postId} {
        allow read, write: if request.auth != null
                            && request.auth.uid == userId;
      }
      match /hidden_comments/{commentId} {
        allow read, write: if request.auth != null
                            && request.auth.uid == userId;
      }
      match /blocked_accounts/{blockedId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /blocked_by/{blockerId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == blockerId
        );
        allow create, delete: if request.auth != null
          && request.auth.uid == blockerId;
      }
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.actorId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked_accounts/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_accounts/$(userId));
        allow update: if request.auth != null && (
          request.auth.uid == userId
          || request.auth.uid in resource.data.actorIds
        );
        allow delete: if request.auth != null && (
          request.auth.uid == userId
          || request.auth.uid in resource.data.actorIds
          || resource.data.actorId == request.auth.uid
        );
      }
    }

    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /community_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (
          resource.data.reporterId == request.auth.uid
          && request.resource.data.reporterId == request.auth.uid
        )
        || isMod()
      );
      allow get: if request.auth != null && (
        !exists(/databases/$(database)/documents/community_reports/$(reportId))
        || resource.data.reporterId == request.auth.uid
        || isMod()
      );
      allow list: if isMod();
      allow delete: if false;
    }

    match /community_comment_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId == request.auth.uid;
      allow get: if request.auth != null && (
        !exists(/databases/$(database)/documents/community_comment_reports/$(reportId))
        || resource.data.reporterId == request.auth.uid
      );
      allow list, delete: if false;
    }

    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      resource.data.authorId == request.auth.uid
                      ||
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'votes',
                          'upvotedBy',
                          'downvotedBy',
                          'comments',
                          'commentsCount',
                          'updatedAt',
                          'searchKeywords'
                        ])
                      || (
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['reportCount', 'reportScore', 'updatedAt'])
                        && request.resource.data.reportCount
                            == resource.data.get('reportCount', 0) + 1
                      )
                      || (
                        isMod()
                        && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['moderation', 'updatedAt', 'reportCount', 'reportScore'])
                      )
                    );
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
      match /poll_responses/{responseId} {
        allow read: if request.auth != null && (
          responseId == request.auth.uid
          || get(/databases/$(database)/documents/community_posts/$(postId))
                .data.authorId == request.auth.uid
        );
        allow create, update: if request.auth != null
          && responseId == request.auth.uid
          && request.resource.data.respondentId == request.auth.uid;
        allow delete: if request.auth != null && (
          responseId == request.auth.uid
          || get(/databases/$(database)/documents/community_posts/$(postId))
                .data.authorId == request.auth.uid
        );
      }
    }
  }
}