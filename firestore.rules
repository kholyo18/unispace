// REVIEW CANDIDATE ONLY: not a complete security policy; do not deploy before compatibility verification.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed per-login identity; client-owned metadata never grants a session.
    function activeSession() {
      return request.auth != null
        && request.auth.token.get('sid', '') is string
        && request.auth.token.get('sid', '').matches('^[a-f0-9]{64}$')
        && request.auth.token.get('firebase', {}).get('tenant', null) == null
        && request.auth.token.auth_time is int && request.auth.token.auth_time > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sid)).data.authSessionVersion == 1
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sid)).data.sessionId == request.auth.token.sid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.auth.token.sid)).data.isRevoked == false
        && get(/databases/$(database)/documents/authRevocations/$(request.auth.uid)).data.revokedBefore is int
        && request.auth.token.auth_time > get(/databases/$(database)/documents/authRevocations/$(request.auth.uid)).data.revokedBefore;
    }
    function validSessionMetadata() {
      let d = request.resource.data;
      return d.get('alias', '') is string && d.get('alias', '').size() <= 200
        && d.get('isTrusted', false) is bool
        && d.get('deviceId', '') is string && d.get('deviceId', '').size() <= 200
        && d.get('model', '') is string && d.get('model', '').size() <= 500
        && d.get('platform', '') is string && d.get('platform', '').size() <= 50
        && d.get('manufacturer', '') is string && d.get('manufacturer', '').size() <= 200
        && d.get('osVersion', '') is string && d.get('osVersion', '').size() <= 500
        && d.get('appVersion', '') is string && d.get('appVersion', '').size() <= 100
        && d.get('buildNumber', '') is string && d.get('buildNumber', '').size() <= 100
        && d.get('locale', '') is string && d.get('locale', '').size() <= 100
        && d.updatedAt == request.time
        && (!d.diff(resource.data).affectedKeys().hasAny(['lastSeenAt']) || d.lastSeenAt == request.time)
        && (resource.data.get('deviceId', null) == null || d.deviceId == resource.data.deviceId);
    }

    // Explicit server-only records; no broad match in this candidate grants access.
    match /communityReportLimits/{uid} { allow read, write: if false; }
    match /communityReportStatusLimits/{uid} { allow read, write: if false; }
    match /usernameReservations/{name} { allow read, write: if false; }
    match /usernameCheckLimits/{uid} { allow read, write: if false; }
    function isMod() {
      return activeSession()
        && request.auth.uid in [
          'QYZAB7X4JyXYgMGGwzgV8U4Mu6f2'
        ];
    }

    match /chats/{chatId} {
      function ownMap(key) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([key]) || (request.resource.data.get(key, {}) is map && resource.data.get(key, {}) is map && request.resource.data.get(key, {}).diff(resource.data.get(key, {})).affectedKeys().hasOnly([request.auth.uid]));
      }
      function activity(key, enabled) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([key]) || (ownMap(key) && (request.resource.data.get(key, {}).get(request.auth.uid, null) == null || (enabled && request.resource.data.get(key, {}).get(request.auth.uid, null) == request.time)));
      }
      function preferences() {
        let uid = request.auth.uid;
        let privacy = get(/databases/$(database)/documents/users/$(uid)).data.get('privacy', {});
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nicknames','muted','autoTranslate','clearedAt','theme','typing','lastReadAt','lastDeliveredAt','unread','pinned_' + uid,'muted_' + uid,'deletedBy_' + uid,'archived_' + uid])
          && ownMap('nicknames') && ownMap('muted') && ownMap('autoTranslate') && ownMap('theme') && ownMap('unread')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unread']) || request.resource.data.unread.get(uid, 0) == 0)
          && activity('clearedAt', true) && activity('lastDeliveredAt', true)
          && activity('lastReadAt', privacy.get('readReceipts', true) == true) && activity('typing', privacy.get('typingIndicator', true) == true);
      }
      allow get: if activeSession() && (resource == null || request.auth.uid in resource.data.memberIds);
      allow list: if activeSession() && request.auth.uid in resource.data.memberIds;
      // Callables own membership, delivery, previews and unread increments.
      allow create, delete: if false;
      allow update: if activeSession() && request.auth.uid in resource.data.memberIds && preferences();
      match /messages/{msgId} {
        function member() { return activeSession() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds; }
        function ownMessageMap(key) { return request.resource.data.get(key, {}) is map && request.resource.data.get(key, {}).diff(resource.data.get(key, {})).affectedKeys().hasOnly([request.auth.uid]); }
        allow read: if member();
        allow create, delete: if false;
        allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions','starredBy','hiddenBy']) && ownMessageMap('reactions') && ownMessageMap('starredBy') && ownMessageMap('hiddenBy');
      }
    }
    match /messageRequests/{requestId} {
      allow read: if activeSession() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow write: if false;
    }


    match /groupInvites/{inviteId} {
      allow read: if activeSession() && (resource.data.receiverId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow write: if false;
    }

    function activeProfileOwner(userId) {
      return activeSession() && request.auth.uid == userId
        && (!exists(/databases/$(database)/documents/authRevocations/$(userId))
          || request.auth.token.auth_time > get(/databases/$(database)/documents/authRevocations/$(userId)).data.revokedBefore);
    }
    // Provisional allowlist: validate every editor/bootstrap path before deployment.
    function editableProfileChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstName','lastName','displayName','userName','name','birthDate','gender','residence',
        'university','faculty','college','level','academic','department','major','studyLevel','section','work','phone','otherInfo',
        'mood','github','linkedin','portfolio','profileImageUrl','coverImageUrl','updatedAt',
        'privacy','profileVisibility','showEmailInProfile','isOnline','lastSeenAt',
        'accountStatus','disabledAt','reactivatedAt','deletedAt','isDeleted','security'
      ]) && editableSecurityChange() && editableAcademicChange();
    }
    function editableAcademicChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['academic'])
        || (request.resource.data.get('academic', {}) is map
          && request.resource.data.get('academic', {}).keys().hasOnly(['college','major','level'])
          && request.resource.data.get('academic', {}).get('college', '') is string
          && request.resource.data.get('academic', {}).get('major', '') is string
          && request.resource.data.get('academic', {}).get('level', '') is string);
    }
    function editableSecurityChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['security'])
        || (resource.data.get('security', {}) is map
          && request.resource.data.get('security', {}) is map
          && request.resource.data.get('security', {}).diff(resource.data.get('security', {}))
            .affectedKeys().hasOnly([
              'loginAlerts','loginAlertsEmail','mfaEnabled','backupCodes',
              'compromisedAt','sessionsRevokedAt','frozen','frozenAt','deletedAt','lastLoginAlert'
            ])
          // Legacy clients only clear this obsolete field; never store recovery codes here.
          && (!request.resource.data.get('security', {}).diff(resource.data.get('security', {}))
                .affectedKeys().hasAny(['backupCodes'])
            || request.resource.data.get('security', {}).get('backupCodes', []) == []));
    }
    match /users/{userId} {
      // Raw profiles contain private account fields; public identity uses readPublicProfile.
      allow get: if activeSession() && request.auth.uid == userId;
      allow list: if false;
      allow update: if activeProfileOwner(userId) && editableProfileChange();
      // Signup and permanent deletion must complete through server-owned lifecycle paths.
      allow create, delete: if false;
      match /fcm_tokens/{tokenId} {
        allow read, write: if activeSession()
                             && request.auth.uid == userId;
      }
      match /follow_requests/{fromId} {
        allow get: if activeSession() && (request.auth.uid == userId || request.auth.uid == fromId);
        allow list: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      match /following/{followedId} {
        allow get: if activeSession() && (request.auth.uid == userId || request.auth.uid == followedId);
        allow list: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      match /followers/{followerId} {
        allow get: if activeSession() && (request.auth.uid == userId || request.auth.uid == followerId);
        allow list: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      match /sessions/{sessionId} {
        // A revoked device can observe only its own status to sign out.
        allow get: if request.auth != null && request.auth.uid == userId
          && request.auth.token.get('sid', '') == sessionId;
        allow read: if activeSession() && request.auth.uid == userId;
        allow create, delete: if false;
        allow update: if activeSession() && request.auth.uid == userId
          && resource.data.authSessionVersion == 1 && resource.data.isRevoked == false
          && validSessionMetadata()
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias','isTrusted','updatedAt'])
            || (sessionId == request.auth.token.sid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['alias','isTrusted','updatedAt','lastSeenAt','deviceId',
                  'model','platform','manufacturer','osVersion','appVersion','buildNumber','locale'])));
      }
      match /saved_posts/{postId} {
        allow read, write: if activeSession()
                            && request.auth.uid == userId;
      }
      match /saved_comments/{commentId} {
        allow read, write: if activeSession()
                            && request.auth.uid == userId;
      }
      match /authored_comments/{commentId} {
        allow read: if activeSession();
        allow write: if activeSession() && request.auth.uid == userId;
      }
      match /hidden_posts/{postId} {
        allow read, write: if activeSession()
                            && request.auth.uid == userId;
      }
      match /hidden_comments/{commentId} {
        allow read, write: if activeSession()
                            && request.auth.uid == userId;
      }
      match /blocked_accounts/{blockedId} {
        allow get: if activeSession() && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow list: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      // Preserve the deployed legacy block-reader permission.
      match /blocked_users/{blockedId} {
        allow read: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      match /blocked_by/{blockerId} {
        allow get: if activeSession() && (request.auth.uid == userId || request.auth.uid == blockerId);
        allow list: if activeSession() && request.auth.uid == userId;
        allow write: if false;
      }
      match /notifications/{notifId} {
        function chatNotification() { return notifId.matches('^chat_.*') || resource.data.get('type', '') == 'message'; }
        allow read: if activeSession() && request.auth.uid == userId;
        // Chat notifications and their reserved IDs are exclusively server-created.
        allow create: if activeSession() && !notifId.matches('^chat_.*')
          && request.resource.data.get('type', '') != 'message'
          && request.resource.data.actorId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked_accounts/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_accounts/$(userId));
        allow update: if activeSession() && (
          (chatNotification() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true)
          || (!chatNotification() && request.resource.data.get('type', '') != 'message'
            && (request.auth.uid == userId || request.auth.uid in resource.data.actorIds))
        );
        allow delete: if activeSession() && (request.auth.uid == userId
          || (!chatNotification() && (request.auth.uid in resource.data.actorIds || resource.data.actorId == request.auth.uid)));
      }

    }

    match /users/{userId}/{fileName} {
      allow read: if activeSession();
      allow write: if activeSession() && request.auth.uid == userId;
    }

    // Upload capabilities are server-owned; clients must use prepareStorageUpload.
    match /storageUploadGrants/{grantId} { allow read, write: if false; }
    match /protectedUploadTickets/{grantId} { allow read, write: if false; }
    match /releasePolicy/{platform} { allow read, write: if false; }
    match /maintenanceCursors/{cursor} { allow read, write: if false; }

    // Migrated to authenticated, server-authorized callables.
    match /community_reports/{reportId} { allow read, write: if false; }

    // Migrated to authenticated, server-authorized callables.
    match /community_comment_reports/{reportId} { allow read, write: if false; }

    match /community_posts/{postId} {
      allow read: if false; // All current post reads, including export, use authorized callables.
      // All post mutations, including author metadata sync, use server callables.
      allow create, update, delete: if false;
      // Results and submission now use owner/caller-authorized callables.
      match /poll_responses/{responseId} { allow read, write: if false; }
    }
  }
}