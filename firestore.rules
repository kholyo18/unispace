rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Admin SDK code may publish a revocation cutoff.
    match /authRevocations/{userId} {
      allow read, write: if false;
    }

    // Recovery verifiers, attempt limits and operation state are server-only.
    match /mfaRecovery/{userId} { allow read, write: if false; }
    match /mfaRecoveryAttempts/{attemptId} { allow read, write: if false; }

    function hasActiveAuthentication() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/authRevocations/$(request.auth.uid))
          || request.auth.token.auth_time >
            get(/databases/$(database)/documents/authRevocations/$(request.auth.uid)).data.revokedBefore);
    }

    match /supportMessages/{messageId} {
      allow create: if isValidSupportMessage();
      allow read, update, delete: if false;
    }

    match /signup_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, update, delete: if hasActiveAuthentication() && request.auth.uid == userId;
      allow create: if false;

      match /sessions/{sessionId} {
        allow read: if hasActiveAuthentication() && request.auth.uid == userId;
        allow create: if hasActiveAuthentication()
          && request.auth.uid == userId
          && isValidSessionDoc(userId, sessionId)
          && request.resource.data.isRevoked == false;
        allow update: if hasActiveAuthentication()
          && request.auth.uid == userId
          && (resource.data.get('isRevoked', false) != true
              || request.resource.data.isRevoked == true)
          && (isSessionRevocation() || isValidSessionDoc(userId, sessionId));
        allow delete: if false;
      }
    }

    // Older installations wrote a different schema. They may be revoked without
    // permitting arbitrary changes to those records or relaxing normal validation.
    function isSessionRevocation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRevoked', 'revokedAt', 'revokeReason', 'updatedAt'
        ])
        && request.resource.data.isRevoked == true
        && request.resource.data.revokedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revokeReason is string;
    }

    function isValidSessionDoc(userId, sessionId) {
      return request.resource.data.keys().hasOnly([
            'sessionId',
            'deviceId',
            'alias',
            'platform',
            'model',
            'manufacturer',
            'osVersion',
            'appVersion',
            'buildNumber',
            'locale',
            'createdAt',
            'lastSeenAt',
            'isTrusted',
            'isRevoked',
            'revokedAt',
            'revokeReason',
            'updatedAt',
            'networkType'
          ])
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId == sessionId
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.size() >= 8
          && request.resource.data.alias is string
          && request.resource.data.alias.size() >= 1
          && request.resource.data.alias.size() <= 100
          && request.resource.data.platform is string
          && request.resource.data.model is string
          && request.resource.data.osVersion is string
          && request.resource.data.appVersion is string
          && request.resource.data.buildNumber is string
          && request.resource.data.isTrusted is bool
          && request.resource.data.isRevoked is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.lastSeenAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && (request.resource.data.manufacturer == null || request.resource.data.manufacturer is string)
          && (request.resource.data.locale == null || request.resource.data.locale is string)
          && (request.resource.data.revokedAt == null || request.resource.data.revokedAt is timestamp)
          && (request.resource.data.revokeReason == null || request.resource.data.revokeReason is string)
          && (request.resource.data.networkType == null || request.resource.data.networkType is string);
    }

    function isValidSupportMessage() {
      return request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'phone',
            'displayName',
            'includeAccountInfo',
            'category',
            'subject',
            'message',
            'appVersion',
            'platform',
            'locale',
            'createdAt',
            'deviceInfo',
            'status'
          ])
          && request.resource.data.status == 'queued'
          && request.resource.data.createdAt == request.time
          && request.resource.data.category in [
            'issue',
            'feature',
            'improvement',
            'report',
            'other'
          ]
          && request.resource.data.subject is string
          && request.resource.data.subject.size() >= 5
          && request.resource.data.subject.size() <= 200
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 5
          && request.resource.data.message.size() <= 2000
          && request.resource.data.appVersion is string
          && request.resource.data.platform is string
          && request.resource.data.locale is string
          && request.resource.data.includeAccountInfo is bool
          && request.resource.data.deviceInfo is map
          && request.resource.data.deviceInfo.keys().hasOnly([
            'deviceId',
            'osVersion'
          ])
          && request.resource.data.deviceInfo.deviceId is string
          && request.resource.data.deviceInfo.deviceId.size() >= 8
          && request.resource.data.deviceInfo.osVersion is string
          && (request.resource.data.uid == null || request.resource.data.uid is string)
          && (request.resource.data.email == null || request.resource.data.email is string)
          && (request.resource.data.phone == null || request.resource.data.phone is string)
          && (request.resource.data.displayName == null || request.resource.data.displayName is string);
    }
  }
}
