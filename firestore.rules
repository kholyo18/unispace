// REVIEW CANDIDATE ONLY: not a complete security policy; do not deploy before compatibility verification.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /storageUploadGrants/{grantId} { allow read, write: if false; }
    // Explicit server-only records; no broad match in this candidate grants access.
    match /communityReportLimits/{uid} { allow read, write: if false; }
    match /communityReportStatusLimits/{uid} { allow read, write: if false; }
    match /usernameReservations/{name} { allow read, write: if false; }
    match /usernameCheckLimits/{uid} { allow read, write: if false; }
    function isMod() {
      return request.auth != null
        && request.auth.uid in [
          'QYZAB7X4JyXYgMGGwzgV8U4Mu6f2'
        ];
    }

    // Shared server-owned revocation cutoff for profiles, chats and relationships.
    function authenticatedSession() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/authRevocations/$(request.auth.uid))
          || request.auth.token.auth_time > get(/databases/$(database)/documents/authRevocations/$(request.auth.uid)).data.revokedBefore);
    }
    // Separate application suspension from the user's voluntary freeze state.
    // A newly authenticated suspended owner may inspect their own status, but
    // cannot use protected social writes or clear the administrative record.
    function activeSession() {
      return authenticatedSession()
        && (!exists(/databases/$(database)/documents/accountStateControls/$(request.auth.uid))
          || (get(/databases/$(database)/documents/accountStateControls/$(request.auth.uid)).data.schemaVersion == 1
            && get(/databases/$(database)/documents/accountStateControls/$(request.auth.uid)).data.adminSuspended == false));
    }
    match /accountStateControls/{userId} { allow read, write: if false; }
    function isCurrentChatMember(chatId) {
      return activeSession()
        && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    // Message interaction metadata belongs to the acting participant, not the
    // message author. Keep legacy single-string reactions and the six-value UI.
    function shortReaction(value) {
      return value is string && value.size() > 0 && value.size() <= 32;
    }
    function validReaction(value) {
      return shortReaction(value)
        || (value is list && value.size() > 0 && value.size() <= 6
          && value.size() == value.toSet().size()
          && shortReaction(value[0])
          && (value.size() < 2 || shortReaction(value[1]))
          && (value.size() < 3 || shortReaction(value[2]))
          && (value.size() < 4 || shortReaction(value[3]))
          && (value.size() < 5 || shortReaction(value[4]))
          && (value.size() < 6 || shortReaction(value[5])));
    }
    function ownReactionValue(data) {
      return !(request.auth.uid in data) || validReaction(data[request.auth.uid]);
    }
    function ownStarValue(data) {
      return !(request.auth.uid in data) || data[request.auth.uid] == true;
    }
    function ownInteractionMapChange(key) {
      let old = resource.data.get(key, {});
      let next = request.resource.data.get(key, {});
      return old is map && next is map
        && next.diff(old).affectedKeys().hasOnly([request.auth.uid])
        && (key == 'reactions' ? ownReactionValue(next) : ownStarValue(next));
    }
    function ownReadReceiptChange() {
      let old = resource.data.get('readBy', []);
      let next = request.resource.data.get('readBy', []);
      // A receipt is monotonic. Only the caller may add their identity, and
      // replacing/deleting the parent list cannot erase anyone's receipt.
      return old is list && next is list
        && next.size() == next.toSet().size()
        && next.hasAll(old)
        && next.toSet().difference(old.toSet()).hasOnly([request.auth.uid])
        && next.removeAll([request.auth.uid]) == old.removeAll([request.auth.uid]);
    }
    function validInitialInteractions() {
      let reactions = request.resource.data.get('reactions', {});
      let stars = request.resource.data.get('starredBy', {});
      let readers = request.resource.data.get('readBy', []);
      return reactions is map && stars is map && readers is list
        && reactions.keys().hasOnly([request.auth.uid]) && ownReactionValue(reactions)
        && stars.keys().hasOnly([request.auth.uid]) && ownStarValue(stars)
        && readers.hasOnly([request.auth.uid]) && readers.size() <= 1;
    }
    function validInteractionChanges() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // Validate only changed containers, so unrelated edits preserve legacy
      // data without granting clients the authority to repair other identities.
      return (!changed.hasAny(['reactions']) || ownInteractionMapChange('reactions'))
        && (!changed.hasAny(['starredBy']) || ownInteractionMapChange('starredBy'))
        && (!changed.hasAny(['readBy']) || ownReadReceiptChange());
    }

    match /chats/{chatId} {
      allow get: if activeSession() && (
        resource == null
        || request.auth.uid in resource.data.memberIds
      );
      allow list: if activeSession()
        && request.auth.uid in resource.data.memberIds;
      allow create: if activeSession()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
      allow update: if activeSession()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;
      match /messages/{msgId} {
        allow read: if isCurrentChatMember(chatId);
        allow create: if isCurrentChatMember(chatId)
          && request.resource.data.authorId == request.auth.uid
          && validInitialInteractions();
        // Authorship is immutable. Being the original author never bypasses
        // current membership or the server-owned session revocation cutoff.
        allow update: if isCurrentChatMember(chatId)
          && request.resource.data.authorId == resource.data.authorId
          && validInteractionChanges()
          && (
            resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['readBy', 'reactions', 'starredBy'])
          );
        allow delete: if isCurrentChatMember(chatId)
          && resource.data.authorId == request.auth.uid;
      }
    }

    function activeProfileOwner(userId) {
      return activeSession() && request.auth.uid == userId;
    }
    // Provisional allowlist: validate every editor/bootstrap path before deployment.
    function editableProfileChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'firstName','lastName','displayName','userName','name','birthDate','gender','residence',
        'university','faculty','college','level','academic','department','major','studyLevel','section','work','phone','otherInfo',
        'mood','github','linkedin','portfolio','profileImageUrl','coverImageUrl','updatedAt',
        'privacy','profileVisibility','showEmailInProfile','isOnline','lastSeenAt',
        'security'
      ]) && editableSecurityChange() && editableAcademicChange();
    }
    function editableAcademicChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['academic'])
        || (request.resource.data.get('academic', {}) is map
          && request.resource.data.get('academic', {}).keys().hasOnly(['college','major','level'])
          && request.resource.data.get('academic', {}).get('college', '') is string
          && request.resource.data.get('academic', {}).get('major', '') is string
          && request.resource.data.get('academic', {}).get('level', '') is string);
    }
    function editableSecurityChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['security'])
        || (resource.data.get('security', {}) is map
          && request.resource.data.get('security', {}) is map
          && request.resource.data.get('security', {}).diff(resource.data.get('security', {}))
            .affectedKeys().hasOnly([
              'loginAlerts','loginAlertsEmail','mfaEnabled','backupCodes',
              'compromisedAt','sessionsRevokedAt','lastLoginAlert'
            ])
          // Legacy clients only clear this obsolete field; never store recovery codes here.
          && (!request.resource.data.get('security', {}).diff(resource.data.get('security', {}))
                .affectedKeys().hasAny(['backupCodes'])
            || request.resource.data.get('security', {}).get('backupCodes', []) == []));
    }
    match /users/{userId} {
      // Raw documents contain private fields. Other-profile readers must use
      // readPublicProfile/searchPeople/readFollowList, never direct user queries.
      allow get: if authenticatedSession() && request.auth.uid == userId;
      allow list: if false;
      allow update: if activeProfileOwner(userId) && editableProfileChange();
      // Signup and permanent deletion must complete through server-owned lifecycle paths.
      allow create, delete: if false;
      // Device tokens and binding metadata are managed only by
      // syncPushDevice/detachPushDevice. The Flutter client does not read them.
      match /fcm_tokens/{tokenId} {
        allow read, write: if false;
      }
      // Accepted relationships are authorization evidence. Only manageFollow
      // may create, modify or remove these records via the Admin SDK.
      match /follow_requests/{fromId} {
        allow get: if activeSession()
          && (request.auth.uid == userId || request.auth.uid == fromId);
        allow list: if activeProfileOwner(userId);
        allow write: if false;
      }
      match /following/{followedId} {
        allow get: if activeSession()
          && (request.auth.uid == userId || request.auth.uid == followedId);
        allow list: if activeProfileOwner(userId);
        allow write: if false;
      }
      match /followers/{followerId} {
        allow get: if activeSession()
          && (request.auth.uid == userId || request.auth.uid == followerId);
        allow list: if activeProfileOwner(userId);
        allow write: if false;
      }
      match /sessions/{sessionId} {
        function sessionFields() {
          return ['sessionId','deviceId','alias','platform','model','manufacturer',
            'osVersion','appVersion','buildNumber','locale','createdAt','lastSeenAt',
            'updatedAt','isTrusted','isRevoked','revokedAt','revokeReason','networkType'];
        }
        function activeSessionRecord() {
          let d = request.resource.data;
          return d.sessionId == sessionId
            && d.deviceId is string && d.deviceId.size() > 0
            && d.alias is string && d.platform is string && d.model is string
            && d.manufacturer is string && d.osVersion is string
            && d.appVersion is string && d.buildNumber is string && d.locale is string
            && d.createdAt is timestamp && d.lastSeenAt is timestamp && d.updatedAt is timestamp
            && d.isTrusted is bool && d.isRevoked == false
            && d.revokedAt == null && d.revokeReason == null
            && (d.get('networkType', null) == null || d.networkType is string);
        }
        function activityOrInitialization() {
          let d = request.resource.data;
          // A legacy record may be initialized by the existing Flutter helper;
          // its unknown fields are preserved, not freely edited or removed.
          return resource.data.get('isRevoked', false) == false
            && d.diff(resource.data).affectedKeys().hasOnly(sessionFields())
            && activeSessionRecord()
            && d.sessionId == resource.data.get('sessionId', sessionId)
            && d.deviceId == resource.data.get('deviceId', d.deviceId)
            && d.createdAt == resource.data.get('createdAt', d.createdAt);
        }
        function oneWayRevocation() {
          let d = request.resource.data;
          // This also handles malformed/legacy records and repeated revocation.
          // Repeating it never permits activity, identity edits or reactivation.
          return d.diff(resource.data).affectedKeys()
              .hasOnly(['isRevoked','revokedAt','revokeReason','updatedAt'])
            && d.isRevoked == true
            && d.revokedAt == request.time && d.updatedAt == request.time
            && d.revokeReason in ['manual','logout_all','logout_all_other'];
        }
        allow read: if activeProfileOwner(userId);
        allow create: if activeProfileOwner(userId)
          && request.resource.data.keys().hasOnly(sessionFields())
          && activeSessionRecord() && request.resource.data.isTrusted == false;
        allow update: if activeProfileOwner(userId)
          && (activityOrInitialization() || oneWayRevocation());
        // Deleting a tombstone would permit recreation of a revoked session ID.
        allow delete: if false;
      }
      match /saved_posts/{postId} {
        allow read, write: if activeProfileOwner(userId);
      }
      match /saved_comments/{commentId} {
        allow read, write: if activeProfileOwner(userId);
      }
      match /authored_comments/{commentId} {
        allow read: if activeSession();
        allow write: if activeProfileOwner(userId);
      }
      match /hidden_posts/{postId} {
        allow read, write: if activeProfileOwner(userId);
      }
      match /hidden_comments/{commentId} {
        allow read, write: if activeProfileOwner(userId);
      }
      match /blocked_accounts/{blockedId} {
        allow get: if activeSession()
          && (request.auth.uid == userId || request.auth.uid == blockedId);
        allow list: if activeProfileOwner(userId);
        allow write: if false;
      }
      match /blocked_by/{blockerId} {
        allow get: if activeSession()
          && (request.auth.uid == userId || request.auth.uid == blockerId);
        allow list: if activeProfileOwner(userId);
        allow write: if false;
      }
      // Legacy block readers still exist in notifications and settings.
      // Owners may inspect them; the server handles unblocking by target UID.
      match /blocked_users/{blockedId} {
        allow read: if activeProfileOwner(userId);
        allow write: if false;
      }
      match /notifications/{notifId} {
        // Identity, content references and delivery metadata are server-owned.
        // Recipients may acknowledge or dismiss, never manufacture an event.
        allow read, delete: if activeProfileOwner(userId);
        allow create: if false;
        allow update: if activeProfileOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // Migrated to authenticated, server-authorized callables.
    match /community_reports/{reportId} { allow read, write: if false; }

    // Migrated to authenticated, server-authorized callables.
    match /community_comment_reports/{reportId} { allow read, write: if false; }

    match /community_posts/{postId} {
      allow read: if false; // All current post reads, including export, use authorized callables.
      // All post mutations, including author metadata sync, use server callables.
      allow create, update, delete: if false;
      // Results and submission now use owner/caller-authorized callables.
      match /poll_responses/{responseId} { allow read, write: if false; }
    }
  }
}
